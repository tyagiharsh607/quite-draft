OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
# minimal keeps latency low for live use; try low/medium if answers feel too shallow
OPENAI_REASONING_EFFORT=minimal
# Optional: path override, defaults to ~/.cache/hyperframes/whisper/models/ggml-small.en.bin
# WHISPER_MODEL_PATH=/path/to/ggml-small.en.bin
# Optional: paste resume/JD text to give the LLM background context
# RESUME_OR_JD_CONTEXT=
